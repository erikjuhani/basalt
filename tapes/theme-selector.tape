Hide
Type "cargo run --release -q -- --theme $BASALT_THEME"
Enter
Sleep 3s
Show
Sleep 1s

# Open a note so theme previews show rendered colours
Type "j"
Sleep 0.3s
Type "j"
Sleep 0.3s
Type "j"
Sleep 0.3s
Type "j"
Sleep 0.3s
Enter
Sleep 1.5s

# Open the theme selector -- scrolling previews each theme live
Space
Type "t"
Sleep 2s

# Browse downward; each highlighted theme previews immediately
Type "j"
Sleep 1.3s
Type "j"
Sleep 1.3s
Type "j"
Sleep 1.3s
Type "j"
Sleep 1.3s
Type "j"
Sleep 1.3s
Type "j"
Sleep 1.3s
Type "j"
Sleep 2.5s
